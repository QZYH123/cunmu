{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cunmu",
  "mainBinaryName": "cunmu",
  "version": "0.1.1",
  "identifier": "com.qzyh123.cunmu",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "存目",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "userAgent": "QZYH123/cunmu/0.1.1 (https://github.com/QZYH123/cunmu)",
        "dragDropEnabled": false,
        "backgroundColor": "#F8F7F5"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https://lain.bgm.tv https://shared.cloudflare.steamstatic.com https://cdn.cloudflare.steamstatic.com https://cdn.akamai.steamstatic.com https://steamcdn-a.akamaihd.net asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://api.bgm.tv https://lain.bgm.tv; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "QZYH123",
    "shortDescription": "存目 Cunmu",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {}
}
