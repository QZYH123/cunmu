{
  "name": "cunmu",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Cunmu — a personal encyclopedia of what you have read, watched, played and listened to (web + Capacitor app)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "check": "node scripts/check-spec.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "unit": "node scripts/unit.mjs",
    "gen:motion": "node scripts/gen-motion-tokens.mjs",
    "smoke": "node scripts/smoke-app.mjs",
    "verify": "npm run build && npm run check && node scripts/check-dist.mjs && node scripts/unit.mjs && node scripts/smoke-app.mjs --no-build",
    "cap:sync": "npm run build && node scripts/check-dist.mjs && cap sync",
    "apk:debug": "node scripts/build-apk.mjs",
    "app:id": "node scripts/apply-app-id.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "fonts:css": "node scripts/make-fonts-css.mjs",
    "win:build": "node scripts/build-win.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.21.5",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "license": "GPL-3.0-or-later",
  "author": "Yanagi (QZYH123) <196919885+QZYH123@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/QZYH123/cunmu.git"
  },
  "homepage": "https://github.com/QZYH123/cunmu"
}
