{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The one window: its own data folder, the save dialog, web links in the browser, Steam's Web API (no CORS there) through tauri-plugin-http.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-save",
    "opener:allow-open-url",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.steampowered.com/*" }, { "url": "https://store.steampowered.com/api/*" }]
    },
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-rename",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }]
    }
  ]
}
